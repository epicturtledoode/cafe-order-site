---
import '../styles/global.css'
const { text, scale, class: className="",id } = Astro.props
---

<button type="button"
    style={`transform: scale(${scale})`}
    id={id}
    class={`bg-green-600 border-green-800 text-white font-bold py-2 px-4 border-b-4 hover:bg-green-500 active:motion-safe:hover:scale-95 transition ease-in-out duration-50 rounded ${className}`}>
    {text}
</button>