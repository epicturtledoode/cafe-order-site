---
import Bakery from '../layouts/bakery.astro'
import Card from '../components/Card.astro'
---

<Bakery title="Donuts">
    
    <div class="m-4">
        <h1 class="inline-block text-2xl font-pixelify text-brown border-dashed border-b-3 border-red-700">
            Holiday Specials
        </h1>
        <div class="w-full flex flex-wrap gap-4 justify-evenly items-center mx-auto my-2 p-3 bg-red-700 rounded-3xl border-dashed border-white border-4">
            <Card image="src/assets/images/santa donut.png" name="Santa Donut" price="3.50"/>
            <Card image="src/assets/images/snowman donut.png" name="Snowman Donut" price="3.50"/>
            <Card image="src/assets/images/christmas tree donut.png" name="Christmas Tree Donut" price="3.50"/>
            <Card image="src/assets/images/candy cane donut.png" name="Candy Cane Donut" price="3.50"/>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 w-full gap-4">

            <div class="lg:col-span-3">
                <h1 class="inline-block text-2xl font-pixelify text-brown border-dashed border-b-3 border-red-700">
                    Classics
                </h1>
                <div class="w-full flex flex-wrap gap-4 justify-evenly items-center mx-auto my-2 p-3 bg-red-700 rounded-3xl border-dashed border-white border-4">
                    <Card image="src/assets/images/chocolate donut.png" name="Chocolate Donut" price="3.00"/>
                    <Card image="src/assets/images/powdered donut.png" name="Powdered Donut" price="3.00"/>
                    <Card image="src/assets/images/boston creme.png" name="Boston Creme" price="3.00"/>
                </div>
            </div>

            <div class="lg:col-span-1">
                <h1 class="inline-block text-2xl font-pixelify text-brown border-dashed border-b-3 border-red-700">
                    Special
                </h1>
                <div class="w-full flex flex-wrap gap-4 justify-evenly items-center mx-auto my-2 p-3 bg-red-700 rounded-3xl border-dashed border-white border-4">
                    <Card image="src/assets/images/sprinkly jelly filled strawberry donut.png" name="Sprinkly Jelly Filled Strawberry Donut" price="3.00" large={true}/>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 w-full gap-4">
            <div class="lg:col-span-1">
                <h1 class="inline-block text-2xl font-pixelify text-brown border-dashed border-b-3 border-red-700">
                    Sprinkly Donuts
                </h1>
                <div class="w-full flex flex-wrap gap-4 justify-evenly items-center mx-auto my-2 p-3 bg-red-700 rounded-3xl border-dashed border-white border-4">
                    <Card image="src/assets/images/sprinkly chocolate donut.png" name="Sprinkly Chocolate Donut" price="3.00" large={true}/>
                    <Card image="src/assets/images/sprinkly strawberry donut.png" name="Sprinkly Strawberry Donut" price="3.00" large={true}/>
                </div>
            </div>

            <div class="lg:col-span-1">
                <h1 class="inline-block text-2xl font-pixelify text-brown border-dashed border-b-3 border-red-700">
                    Jelly Filled Donuts
                </h1>
                <div class="w-full flex flex-wrap gap-4 justify-evenly items-center mx-auto my-2 p-3 bg-red-700 rounded-3xl border-dashed border-white border-4">
                    <Card image="src/assets/images/jelly filled powdered donut.png" name="Jelly Filled Powdered Donut" price="3.00" large={true}/>
                    <Card image="src/assets/images/jelly filled strawberry donut.png" name="Jelly Filled Strawberry Donut" price="3.00" large={true}/>
                </div>
            </div>
        </div>

    </div>
</Bakery>