---
import '../styles/global.css'
import Button from '../components/button.astro'
const { image, name, price, large} = Astro.props
---

<body>
    <div class="w-42 rounded border-4 border-brown border-b-8 relative bg-yellow">

        <img class="w-2/3 object-cover mx-auto object-[calc(50%-2px)_50%]" src={image} alt={name}>
        <div class="text-center bg-brown border-t-4 border-white text-white p-2 h-30 flex flex-col text-xl">

            <div class={`font-bold font-pixelify ${large && 'text-sm'}`}>{name}</div>

            <div class="flex items-center justify-between mt-auto">
                <div class="text-base font-IBMplex w-full">{price}$</div>
                <Button text="Add", scale="0.5"/>
            </div>
            
        </div>
    </div>
</body>

