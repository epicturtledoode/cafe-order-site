---
import '../styles/global.css'
const { cvisible=true } = Astro.props
---

<div class="max-w bg-yellow border-b-4 border-red-700 flex items-center">
    <a href="/" class="text-brown m-4 text-2xl font-bold font-pixelify ">Pixil Cafe</a>
    <a href="/donuts" class="text-brown text-1xl hover:bg-red-700 hover:text-white active:bg-red-700 active:text-white font-IBMplex m-4 ">Donuts</a>
    <a href="/drinks" class="text-brown text-1xl hover:bg-red-700 hover:text-white active:bg-red-700 active:text-white font-IBMplex m-4">Drinks</a>

    {cvisible && (
        <a href="/cart" class="ml-auto mr-6">
            <img src="src\assets\images\icons8-shopping-cart-32.png" alt="Shopping Cart">
        </a>
    )}

</div>

