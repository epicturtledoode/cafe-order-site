---
import '../styles/global.css'
const { image, name, price} = Astro.props
---

<div class="w-48 rounded overflow-hidden shadow-md bg-yellow outline-4 outline-red-800">
    <img class="w-2/3 h-30 object-cover mx-auto object-[calc(50%-2px)_50%]" src={image} alt={name}>
    <div class="font-bold text-xl text-center">{name}</div>
    <div class="text-base text-center">{price}$</div>
</div>