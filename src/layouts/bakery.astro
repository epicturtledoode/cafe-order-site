---
import '../styles/global.css'
import { Font } from "astro:assets"
import Header from '../components/header.astro'

const {title = "Pixel Cafe"} = Astro.props
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content ={Astro.generator} >

        <Font cssVariable='--font-pixelify' preload/>
        <Font cssVariable='--font-IBMplex' preload/>
        <title>{title} | Pixel Cafe</title>
    </head>
    <body class="bg-lightyellow">
        <Header cvisible={true}/>
        <p id="balance" class="text-green-800 font-bold">Balance: </p>
        <h1 class="text-2xl font-pixelify text-brown text-center">{title}</h1>
        <slot />
    </body>
</html>

<script>
    const money = localStorage.getItem("money");
    const balance = document.getElementById("balance")

    if (balance && money) {
        balance.textContent = `Balance: $${money}`
    }
</script>