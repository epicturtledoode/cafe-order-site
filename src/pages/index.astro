---
import '../styles/global.css'
import { Font } from "astro:assets"
import Header from '../components/header.astro'
import Button from '../components/button.astro'
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="src/assets/images/marshmellow hot chocolate.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content ={Astro.generator} >
        <Font cssVariable='--font-pixelify' preload/>
        <Font cssVariable='--font-IBMplex' preload/>
        <title>Pixel Cafe</title>
    </head>

    <Header cvisible={false} lvisible={false}/>

    <body class="bg-lightyellow min-h-screen flex flex-col">
        <main class="flex flex-1 flex-col items-center justify-center">
            <h1 id="bigText" class="font-pixelify text-5xl ">Buy food on a budget!</h1>
            <h2 id="smallText" class="text-brown font-IBMplex">Press roll to determine your budget ($10-100)</h2>
            <div class="mt-4 flex flex-row">
                <button id="moneyDisplay" class="border-3 border-b-4 w-20 border-green-800 rounded mr-3 text-shadow-2xs text-shadow-green-800 font-bold text-white bg-green-600/40 text-xl">
                    $???
                </button>
                <Button text="Roll money", id="rollButton", class="visible"/>
                <a href="\donuts">
                    <Button text="Continue", scale="1", id="continueButton", class="hidden"/>
                </a>
            </div>
            
        </main>
    </body>
</html>

<script>
    let rolled = false
    const rollButton = document.getElementById("rollButton") as HTMLButtonElement
    const moneyDisplay = document.getElementById("moneyDisplay")
    const continueButton = document.getElementById("continueButton") as HTMLButtonElement
    const bigText = document.getElementById("bigText")
    const smallText = document.getElementById("smallText")

    rollButton?.addEventListener("click", () => {
        if (rolled == false) {
            rollButton.disabled = true;
            let money = String((Math.round(Math.random()*90))+10);
            const duration = 4000;
            const startTime = performance.now();

            function countdown(currentTime: number) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);

                const currentMoney = Math.round(100 - (100-Number(money))*progress);

            if (moneyDisplay) {
                moneyDisplay.textContent = `$${currentMoney}`;
            }

            if (progress < 1) {
                requestAnimationFrame(countdown);
            } else {
                rolled = true;
                localStorage.setItem("money", String(money));
                if (bigText && smallText) {
                    bigText.textContent = `You got $${money} to spend!`
                    smallText.textContent = "The min was $10, and the max was $100"
                }

                rollButton.classList.replace("visible","hidden")
                continueButton.classList.replace("hidden","visible")
            }
        }
            requestAnimationFrame(countdown);
            }
    })
</script>