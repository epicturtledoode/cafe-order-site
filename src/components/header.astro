---
import '../styles/global.css'
const { cvisible=true } = Astro.props
const { lvisible=true } = Astro.props
const page = Astro.url.pathname
---

<div class="max-w bg-yellow border-b-4 border-red-700 flex items-center">
    <a href="/" class="text-brown m-4 text-2xl font-bold font-pixelify ">Pixil Cafe</a>
    {lvisible && (
        <a href="/donuts" class={`text-brown text-1xl hover:bg-red-700 hover:text-white font-IBMplex m-4
        ${page === "/donuts" ? "bg-red-700 text-white" : ""}`}>Donuts</a>
        <a href="/drinks" class={`text-brown text-1xl hover:bg-red-700 hover:text-white font-IBMplex m-4
        ${page === "/drinks" ? "bg-red-700 text-white" : ""}`}>Drinks</a>
    )}

    {cvisible && (
        <a href="/cart" class="ml-auto mr-6">
            <img src="src\assets\images\icons8-shopping-cart-32.png" alt="Shopping Cart">
        </a>
    )}

</div>

