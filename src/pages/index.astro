---
import '../styles/global.css'
import { Font } from "astro:assets"
import Header from '../components/header.astro'
import Button from '../components/button.astro'
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content ={Astro.generator} >
        <Font cssVariable='--font-pixelify' preload/>
        <title>Cafe website thing</title>
    </head>
    <body class="bg-lightyellow min-h-screen flex flex-col">
        <Header />
        <main class="flex flex-1 flex-col items-center justify-center">
            <h1 class="font-pixelify text-5xl ">LET'S GO SHOPPING!</h1>
            <h2 class="text-brown">But first, determine how much money you have!</h2>
            <Button text="Roll money"/>
        </main>
    </body>
</html>