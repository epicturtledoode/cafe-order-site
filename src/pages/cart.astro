---
import '../styles/global.css'
import { Font } from "astro:assets"
import Header from '../components/header.astro'
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content ={Astro.generator} >
        <Font cssVariable='--font-pixelify' preload/>
        <Font cssVariable='--font-IBMplex' preload/>
        <title>Cart | Pixel Cafe</title>
    </head>

    <body class="bg-lightyellow">
        <Header />
        <div class="flex justify-center mt-4">
            <div class="w-2/3 border-3 p-4">
                <h1 class="font-pixelify text-2xl mb-6">Your Cart</h1>
                <ul id="cart-list" class="font-IBMplex">

                </ul>
            </div>
        </div>
    </body>
</html>

<script>
    const cart = JSON.parse(localStorage.getItem("cart") || "{}");
    const cartList = document.querySelector("#cart-list")

    if (cartList) {
        if (Object.keys(cart).length === 0) {
            cartList.innerHTML = 'Your cart is empty, <a href="/donuts" class="text-red-700 underline"> try adding something</a>';
        } else {
            Object.entries(cart).forEach(([name, quantity]) => {
                const li = document.createElement("li");
                li.className = "border-b-2 border-dashed mb-4";

                li.textContent = name + quantity;
                cartList.appendChild(li);

            });
        }
    }

</script>