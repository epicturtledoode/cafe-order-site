---
import '../styles/global.css'
const { text } = Astro.props
---
<button type="submit" class="bg-blue-500 hover:bg-blue-400 text-white font-bold py-2 px-4 border-b-4 border-blue-700 hover:border-blue-500 active:motion-safe:hover:scale-90 transition ease-in-out duration-50 rounded">
im a button {text}
</button>