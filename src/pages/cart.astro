---
import '../styles/global.css'
import { Font } from "astro:assets"
import Header from '../components/header.astro'
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/src/assets/images/marshmellow hot chocolate.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content ={Astro.generator} >
        <Font cssVariable='--font-pixelify' preload/>
        <Font cssVariable='--font-IBMplex' preload/>
        <title>Cart | Pixel Cafe</title>
    </head>

    <body class="bg-lightyellow">
        <Header />
        <div class="flex justify-center mt-6">
            <div class="w-2/3 border-3 p-6">
                <div class="font-pixelify text-2xl border-b-3 border-red-700 mb-4">Your Cart</div>
                <ul id="cart-list" class="font-IBMplex">
                    <li id="total-display" class="border-2 border-dashed border-red-700 p-2">Cart total:</li>
                </ul>
            </div>
        </div>
    </body>
</html>

<script>
    type cartItem = {
        quantity: number;
        price: number;
        icon: string;
    };

    const cart: Record<string, cartItem> = JSON.parse(localStorage.getItem("cart") || "{}");
    
    const cartList = document.getElementById("cart-list");
    const totalDisplay = document.getElementById("total-display");
    var cartTotal = 0;

    if (cartList) {
        if (Object.keys(cart).length === 0) {
            cartList.innerHTML = 'Your cart is empty, <a href="/donuts" class="text-red-700 underline"> try adding something</a>';
        } else {
            Object.entries(cart).forEach(([name, item]) => {
                const li = document.createElement("li");
                li.className = "border-b-2 border-dashed mb-4 flex items-center p-2";

                const img = document.createElement("img");
                img.src = item.icon;
                img.alt = name;
                img.className = "mr-2 w-12"

                const removeBtn = document.createElement("button");
                removeBtn.textContent = "x";
                removeBtn.className = "bg-red-700 text-white w-6 h-6 cursor-pointer";

                const addBtn = document.createElement("button");
                addBtn.textContent = "+";
                addBtn.className = "bg-red-700 text-white w-6 h-6 cursor-pointer";

                const subBtn = document.createElement("button");
                subBtn.textContent = "-";
                subBtn.className = "bg-red-700 text-white w-6 h-6 cursor-pointer";

                const subTotal = document.createElement("span");
                subTotal.textContent = `$${(item.price*item.quantity).toFixed(2)}`;
                subTotal.className = "font-bold whitespace-nowrap";

                const quantCounter = document.createElement("span");
                quantCounter.textContent = `${item.quantity}`;
                quantCounter.className = "px-2"

                removeBtn.addEventListener("click", () => {
                    delete cart[name];
                    localStorage.setItem("cart", JSON.stringify(cart));
                    li.remove();
                });

                subBtn.addEventListener("click", () => {
                    if (item.quantity == 1) {
                        delete cart[name];
                        localStorage.setItem("cart", JSON.stringify(cart));
                        li.remove();
                    } else {
                        item.quantity -= 1;
                        quantCounter.textContent = `${item.quantity}`;
                        subTotal.textContent = `$${(item.price*item.quantity).toFixed(2)}`;
                        localStorage.setItem("cart", JSON.stringify(cart));
                    }
                });

                addBtn.addEventListener("click", () => {
                    item.quantity += 1;
                    subTotal.textContent = `$${(item.price*item.quantity).toFixed(2)}`;
                    localStorage.setItem("cart", JSON.stringify(cart));
                })

                const controls = document.createElement("div");
                controls.className = "flex items-center gap-2 ml-auto";
                
                controls.appendChild(subBtn);
                controls.appendChild(quantCounter);
                controls.appendChild(addBtn);
                controls.appendChild(subTotal);
                controls.appendChild(removeBtn);
                
                li.appendChild(img);
                li.append(`${name} - $${(item.price).toFixed(2)}`);
                li.appendChild(controls);

                cartList.prepend(li);

            });
        }
    }

</script>