---
import Bakery from '../layouts/bakery.astro'
import Card from '../components/Card.astro'
---

<Bakery title="Donuts">
    <div class="flex flex-row justify-evenly mt-2">
        <Card image="src\assets\images\santa donut.png" name="Santa Donut" price="3.00"/>
        <Card image="src\assets\images\snowman donut.png" name="Snowman Donut" price="3.00"/>
        <Card image="src\assets\images\christmas tree donut.png" name="Christmas Tree Donut" price="3.00"/>
        <Card image="src\assets\images\candy cane donut.png" name="Candy Cane Donut" price="3.00"/>
    </div>
    <div class="flex flex-row justify-evenly mt-2">
        <Card image="src\assets\images\chocolate donut.png" name="Chocolate Donut" price="3.00"/>
        <Card image="src\assets\images\powdered donut.png" name="Powdered Donut" price="3.00"/>
        <Card image="src\assets\images\boston creme donut.png" name="Boston Creme" price="3.00"/>
    </div>
    <div class="flex flex-row justify-evenly mt-2">
        <Card image="src\assets\images\sprinkly chocolate donut.png" name="Sprinkly Chocolate Donut" price="3.00"/>
        <Card image="src\assets\images\sprinkly strawberry donut.png" name="Sprinkly Strawberry Donut" price="3.00"/>
    </div>
    <div class="flex flex-row justify-evenly mt-2">
        <Card image="src\assets\images\jelly filled powdered donut.png" name="Jelly Filled Powdered Donut" price="3.00"/>
        <Card image="src\assets\images\jelly filled strawberry donut.png" name="Jelly Filled Strawberry Donut" price="3.00"/>
    </div>
    <div class="flex flex-row justify-evenly mt-2">
        <Card image="src\assets\images\sprinkly jelly filled strawberry donut.png" name="Sprinkly Jelly Filled Strawberry Donut" price="3.00"/>
    </div>
</Bakery>