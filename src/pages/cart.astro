---
import '../styles/global.css'
import { Font } from "astro:assets"
import Header from '../components/header.astro'
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/src/assets/images/marshmellow hot chocolate.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content ={Astro.generator} >
        <Font cssVariable='--font-pixelify' preload/>
        <Font cssVariable='--font-IBMplex' preload/>
        <title>Cart | Pixel Cafe</title>
    </head>

    <body class="bg-lightyellow">
        <Header />
        <div class="flex justify-center mt-6">
            <div class="w-2/3 border-3 p-6">
                <div class="font-pixelify text-2xl border-b-3 border-red-700 mb-4">Your Cart</div>
                <ul id="cart-list" class="font-IBMplex">
                    <li id="total-display" class="border-2 border-dashed border-red-700 p-2">Cart total:</li>
                </ul>
            </div>
        </div>
    </body>
</html>

<script>
    type cartItem = {
        quantity: number;
        price: number;
        icon: string;
    };

    const cart: Record<string, cartItem> = JSON.parse(localStorage.getItem("cart") || "{}");
    
    const cartList = document.getElementById("cart-list");
    const totalDisplay = document.getElementById("total-display");
    var cartTotal = 0;

    if (cartList) {
        if (Object.keys(cart).length === 0) {
            cartList.innerHTML = 'Your cart is empty, <a href="/donuts" class="text-red-700 underline"> try adding something</a>';
        } else {
            Object.entries(cart).forEach(([name, item]) => {
                const li = document.createElement("li");
                li.className = "border-b-2 border-dashed mb-4 flex items-center p-2";

                const img = document.createElement("img")
                img.src = item.icon;
                img.alt = name;
                img.className = "mr-2 w-12"

                li.appendChild(img)
                li.append(`${name} x ${item.quantity} - $${item.price*item.quantity}`);
                cartList.prepend(li);


            });
        }
    }

</script>