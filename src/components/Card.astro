---
import '../styles/global.css'
const { image, name, price, large=false} = Astro.props
---

<body>
    <div class="w-42 rounded border-4 border-brown border-b-8 relative bg-yellow">

        <img class="w-2/3 mx-auto object-[calc(50%-2px)_50%] [image-rendering:pixelated]" src={image} alt={name}>
        <div class="text-center bg-brown border-t-4 border-white text-white p-2 h-30 flex flex-col text-xl">

            <div class={`font-bold font-pixelify ${large && 'text-sm'}`}>{name}</div>

            <div class="flex items-center mt-auto relative">
                <div class="ml-2 text-base font-IBMplex w-full">{price}$</div>
                <button data-add-to-cart data-id={name} data-price={price} data-icon={image} class="mr-2 scale-55 whitespace-nowrap bg-green-600 border-green-800 text-white font-bold py-2 p-4 border-b-4 hover:bg-green-500 active:motion-safe:hover:scale-60 transition ease-in-out duration-50 rounded disabled:opacity-50 disabled:cursor-not-allowed">
                    Add
                </button>
                
            </div>
            
        </div>
    </div>
</body>

