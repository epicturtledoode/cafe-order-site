---
import '../styles/global.css'
import { Font } from "astro:assets"
import Header from '../components/header.astro'

const {title = "Pixel Cafe"} = Astro.props
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="src/assets/images/marshmellow hot chocolate.png" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content ={Astro.generator} >

        <Font cssVariable='--font-pixelify' preload/>
        <Font cssVariable='--font-IBMplex' preload/>
        <title>{title} | Pixel Cafe</title>
    </head>
    <body class="bg-lightyellow">
        <Header cvisible={true}/>
        <div class="flex items-center relative w-full m-4">
            <h1 class="text-2xl font-IBMplex text-white bg-red-700 absolute left-1/2 -translate-x-1/2">{title}</h1>
            <p id="budget" class="text-green-800 font-bold mr-8 font-IBMplex">Budget: </p>
            <p id="cartBal" class="text-green-800 font-bold ml-auto mr-8 font-IBMplex">In cart: $0</p>
        </div>
        <slot />
    </body>
</html>

<script>
    import "../scripts/cart.js";
    const money = localStorage.getItem("money");
    const cartTotal = localStorage.getItem("cartTotal");
    const budget = document.getElementById("budget");
    const cartBal = document.getElementById("cartBal");

    if (budget && money) {
        budget.textContent = `Budget: $${money}`;
    }

    if (cartBal && cartTotal) {
        cartBal.textContent = `In cart: $${cartTotal}`
    }
</script>